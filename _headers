# Netlify reads this file verbatim (copied into out/ by the build).
# Replaces next.config `headers()`, which static export forbids.

# The tour reels are immutable, content-addressed by filename
# (01-living-room.mp4 …) and preloaded from /g404's <head>. A
# returning QR guest must get them from cache — without this,
# Netlify's default would revalidate ~14MB on every visit.
/rooms/:path/room-reels/:file*
  Cache-Control: public, max-age=31536000, immutable

/rooms/:path/room-reels/posters/:file*
  Cache-Control: public, max-age=31536000, immutable

# The collection reels are immutable, filename-addressed (see
# COLLECTION_REELS in lib/typePages.js) and preloaded from the
# collection page's <head> — a returning visitor must get the ~90MB
# film from cache, never revalidate it.
/collections/:file*
  Cache-Control: public, max-age=31536000, immutable

# --- Lighthouse: efficient cache lifetimes (2026-09-24) ---
# Netlify's default for static assets is a short revalidate window;
# Lighthouse flagged ~4.7MB (landing film + room/social photos) as
# cacheable. All of these are filename-addressed (long unique Airbnb
# export names / hashed _next paths), so a year immutable is safe.

# The landing hero film — 3.4MB on every first visit; returning
# visitors must play it from disk, not the network.
/landing-video.mp4
  Cache-Control: public, max-age=31536000, immutable

# Room photos (everything under /rooms/ that isn't already covered
# by the reel rules above).
/rooms/:path*
  Cache-Control: public, max-age=31536000, immutable

# Instagram feed photos (/social/ig-<id>.jpg — immutable ids).
/social/:file*
  Cache-Control: public, max-age=31536000, immutable

# Brand marks & favicon — small but requested on every page load.
/logo*.png
  Cache-Control: public, max-age=31536000, immutable
/favicon.png
  Cache-Control: public, max-age=31536000, immutable
/mono-terra-64.png
  Cache-Control: public, max-age=31536000, immutable
